## 35 fork 先问后挂:cgroup_can_fork(Linux 7.0 kernel/cgroup/cgroup.c)

[visual: code_explain lang=c title="fork 先问后挂:cgroup_can_fork(Linux 7.0 kernel/cgroup/cgroup.c)"]
	ret = cgroup_css_set_fork(kargs);
	if (ret)
		return ret;

	do_each_subsys_mask(ss, i, have_canfork_callback) {
		ret = ss->can_fork(child, kargs->cset);
		if (ret)
			goto out_revert;
	} while_each_subsys_mask();

	return 0;
