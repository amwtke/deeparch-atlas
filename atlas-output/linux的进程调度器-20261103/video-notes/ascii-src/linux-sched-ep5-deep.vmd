## 14 两条 movq

[visual: code_explain lang=asm title="__switch_to_asm：两条 movq 之间换了一个人（Linux 6.12 arch/x86/entry/entry_64.S）"]
SYM_FUNC_START(__switch_to_asm)
	/*
	 * Save callee-saved registers
	 * This must match the order in inactive_task_frame
	 */
	pushq	%rbp
	pushq	%rbx
	pushq	%r12
	pushq	%r13
	pushq	%r14
	pushq	%r15

	/* switch stack */
	movq	%rsp, TASK_threadsp(%rdi)
	movq	TASK_threadsp(%rsi), %rsp

#ifdef CONFIG_STACKPROTECTOR
	movq	TASK_stack_canary(%rsi), %rbx
	movq	%rbx, PER_CPU_VAR(fixed_percpu_data + FIXED_stack_canary)
#endif

	/*
	 * When switching from a shallower to a deeper call stack
	 * the RSB may either underflow or use entries populated
	 * with userspace addresses. On CPUs where those concerns
	 * exist, overwrite the RSB with entries which capture
	 * speculative execution to prevent attack.
	 */
	FILL_RETURN_BUFFER %r12, RSB_CLEAR_LOOPS, X86_FEATURE_RSB_CTXSW

	/* restore callee-saved registers */
	popq	%r15
	popq	%r14
	popq	%r13
	popq	%r12
	popq	%rbx
	popq	%rbp

	jmp	__switch_to
SYM_FUNC_END(__switch_to_asm)
===HIGHLIGHT===
lines=6-11
压 6 个 callee-saved 寄存器
顺序必须和 inactive_task_frame 一致
压在 prev 自己的内核栈上
===HIGHLIGHT===
lines=14-14
prev->thread.sp = 当前栈顶
prev 被冻结在这里
entry_64.S 第 190 行
===HIGHLIGHT===
lines=15-15
rsp = next->thread.sp
从这一刻起，站在 next 的栈上
===HIGHLIGHT===
lines=32-37
弹出 6 个寄存器
弹的是 next 上次被冻结时压的值
===HIGHLIGHT===
lines=39-39
jmp __switch_to
C 收尾：FS/GS、TLS、FPU
更新 per-CPU 的 current

[narration]
全部魔法就在这十几条汇编里。先把六个寄存器压到旧任务的栈上，再用两条 movq：一条把栈顶存进旧任务的账本，一条把新任务存过的栈顶装进 rsp。第二条执行完，我们就站在新任务的栈上了。随后六条 pop，弹出的是新任务上次冻结时压的值。

